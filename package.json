{
  "name": "claude-session-board",
  "version": "2.2.0",
  "description": "Claude Code 会话看板 —— 并发会话状态面板（Windows / macOS）",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "icon": "electron app/make-icon.js",
    "pack:win": "electron-packager . ClaudeBoard --platform=win32 --arch=x64 --out=dist --overwrite --asar=false --icon=app/icon.ico --ignore=\"(^/dist$|^/node_modules/electron$|^/state$|^/(capture|watch-flicker|close-board)\\.ps1$|.vbs$|.cmd$|^/ui.*.json$|^/hidden.json$|^/_last-payload|^/_env-probe|^/cc-board-focuswin|^/board-capture|^/frames|^/\\.(claude|sdlc|deepcritique|quality-lint-state|gitattributes|gitignore)|^/docs$|^/CLAUDE\\.md$|^/package-lock\\.json$|^/app/icon-source\\.jpg$)\" && node postpack.js",
    "pack:mac": "electron-packager . ClaudeBoard --platform=darwin --arch=arm64 --out=dist --overwrite --asar=false --icon=app/icon.icns --ignore=\"(^/dist$|^/node_modules/electron$|^/state$|^/(capture|watch-flicker|close-board)\\.ps1$|.vbs$|.cmd$|^/ui.*.json$|^/hidden.json$|^/_last-payload|^/_env-probe|^/cc-board-focuswin|^/board-capture|^/frames|^/\\.(claude|sdlc|deepcritique|quality-lint-state|gitattributes|gitignore)|^/docs$|^/CLAUDE\\.md$|^/package-lock\\.json$|^/app/icon-source\\.jpg$)\" && node postpack.js"
  },
  "private": true,
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-packager": "^17.1.2"
  }
}
